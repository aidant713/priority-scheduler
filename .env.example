# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Project Settings → API → service_role. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Google OAuth (same client you register in Supabase Auth → Providers → Google)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL (used for OAuth redirects). Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32-byte key (base64) used to encrypt the Google refresh token at rest.
# Generate with:  openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
